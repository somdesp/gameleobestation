# GameLeoBeStation - tela de carregamento animada (Plymouth)

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

NUM_FRAMES = 9;
TICKS_PER_FRAME = 7;   # ~140 ms por quadro (Plymouth atualiza ~50x por segundo)

i = 0;
while (i < NUM_FRAMES) {
    frames[i] = Image("frame-" + i + ".png");
    i++;
}

anim.sprite = Sprite(frames[0]);
anim.x = cx - frames[0].GetWidth() / 2;
anim.y = cy - frames[0].GetHeight() / 2;
anim.sprite.SetPosition(anim.x, anim.y, 10);

tick = 0;
fun refresh_callback () {
    tick++;
    f = Math.Int(tick / TICKS_PER_FRAME) % NUM_FRAMES;
    anim.sprite.SetImage(frames[f]);
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- Senha (caso use criptografia de disco) ----
prompt.sprite = Sprite();
bullets.sprite = Sprite();
base_y = anim.y + frames[0].GetHeight() + 10;

fun display_password_callback (prompt_text, bullet_count) {
    prompt.image = Image.Text(prompt_text, 0.9, 0.92, 1);
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(cx - prompt.image.GetWidth() / 2, base_y, 20);
    dots = "";
    j = 0;
    while (j < bullet_count) {
        dots = dots + "*";
        j++;
    }
    bullets.image = Image.Text(dots + " ", 0, 0.9, 1);
    bullets.sprite.SetImage(bullets.image);
    bullets.sprite.SetPosition(cx - bullets.image.GetWidth() / 2, base_y + 30, 20);
    prompt.sprite.SetOpacity(1);
    bullets.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ---- Mensagens do sistema ----
msg.sprite = Sprite();
fun message_callback (text) {
    msg.image = Image.Text(text, 0.6, 0.6, 0.7);
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetPosition(cx - msg.image.GetWidth() / 2, Window.GetY() + Window.GetHeight() - 60, 20);
}
Plymouth.SetMessageFunction(message_callback);

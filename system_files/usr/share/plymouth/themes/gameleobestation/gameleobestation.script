# GameLeoBeStation - tela de carregamento (Plymouth)

Window.SetBackgroundTopColor(0.031, 0.031, 0.059);
Window.SetBackgroundBottomColor(0.031, 0.031, 0.059);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2 - 60, 10);

word.image = Image("wordmark.png");
word.sprite = Sprite(word.image);
word.sprite.SetPosition(cx - word.image.GetWidth() / 2, cy + logo.image.GetHeight() / 2 - 20, 10);

track.image = Image("track.png");
track.sprite = Sprite(track.image);
track.x = cx - track.image.GetWidth() / 2;
track.y = cy + logo.image.GetHeight() / 2 + 50;
track.sprite.SetPosition(track.x, track.y, 10);

bar.image = Image("bar.png");
bar.sprite = Sprite(bar.image);
bar.sprite.SetPosition(track.x, track.y, 11);

tick = 0;

fun refresh_callback () {
    tick++;
    logo.sprite.SetOpacity(0.8 + 0.2 * Math.Sin(tick / 18));
    pos = (Math.Sin(tick / 22) + 1) / 2;
    bar.sprite.SetX(track.x + pos * (track.image.GetWidth() - bar.image.GetWidth()));
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- Senha (caso use criptografia de disco) ----
prompt.sprite = Sprite();
bullets.sprite = Sprite();

fun display_password_callback (prompt_text, bullet_count) {
    prompt.image = Image.Text(prompt_text, 0.9, 0.92, 1);
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(cx - prompt.image.GetWidth() / 2, track.y + 40, 20);
    dots = "";
    i = 0;
    while (i < bullet_count) {
        dots = dots + "*";
        i++;
    }
    bullets.image = Image.Text(dots + " ", 0, 0.9, 1);
    bullets.sprite.SetImage(bullets.image);
    bullets.sprite.SetPosition(cx - bullets.image.GetWidth() / 2, track.y + 70, 20);
    track.sprite.SetOpacity(0);
    bar.sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
    track.sprite.SetOpacity(1);
    bar.sprite.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ---- Mensagens do sistema ----
msg.sprite = Sprite();
fun message_callback (text) {
    msg.image = Image.Text(text, 0.6, 0.6, 0.7);
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetPosition(cx - msg.image.GetWidth() / 2, Window.GetY() + Window.GetHeight() - 60, 20);
}
Plymouth.SetMessageFunction(message_callback);

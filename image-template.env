# Configuracao da sua distro
# IMPORTANTE: o nome do repositorio no GitHub precisa ser exatamente "gameleobestation"

IMAGE_NAME=gameleobestation

# Troque pelo seu usuario do GitHub (tudo em minusculas)
REPO_ORGANIZATION="somdesp"

